# Mythiq Platform Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Primary API endpoint (points to mythiq-agent)
VITE_API_BASE_URL=https://mythiq-agent-production.up.railway.app

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test execution settings
TEST_TIMEOUT=30000
TEST_RETRIES=3
TEST_VERBOSE=false
TEST_CONCURRENCY=5
TEST_PERFORMANCE_THRESHOLD=5000
TEST_OUTPUT_FORMAT=console

# CI/CD settings
CI=false

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=

# Monitoring and analytics (optional)
ANALYTICS_ID=
SENTRY_DSN=
