{
  "name": "mythiq-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Revolutionary AI Creative Ecosystem with Self-Learning Capabilities",
  "author": "Mythiq Platform",
  "license": "MIT",
  "keywords": ["ai", "creative", "video", "games", "images", "self-learning"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    
    "test": "npm run test:health && npm run test:services",
    "test:health": "./scripts/test-health.sh",
    "test:health:verbose": "./scripts/test-health.sh --verbose",
    "test:services": "node scripts/test-health.js",
    "test:services:json": "node scripts/test-health.js --format json",
    "test:services:xml": "node scripts/test-health.js --format xml",
    
    "health": "./scripts/test-health.sh --quick",
    "health:full": "./scripts/test-health.sh --comprehensive",
    "health:monitor": "./scripts/test-health.sh --monitor",
    
    "validate": "npm run lint && npm run test",
    "validate:ci": "npm run lint && npm run test:services:xml",
    
    "monitor:start": "node scripts/test-health.js --monitor --interval 300",
    "monitor:stop": "pkill -f 'test-health.js.*monitor'",
    
    "deploy:check": "npm run validate && echo 'Ready for deployment'",
    "deploy:verify": "sleep 30 && npm run health:full",
    
    "debug:logs": "node scripts/test-health.js --debug --logs",
    "debug:network": "./scripts/test-health.sh --debug --network",
    "debug:performance": "node scripts/test-health.js --performance",
    
    "report:generate": "node scripts/test-health.js --report --output test-results/",
    "report:daily": "node scripts/test-health.js --report --daily",
    "report:summary": "cat test-results/latest-results.json | jq '.summary'",
    
    "setup:env": "cp .env.example .env.local && echo 'Please configure your environment variables'",
    "setup:hooks": "chmod +x scripts/*.sh && echo 'Git hooks configured'",
    
    "clean": "rm -rf dist/ test-results/*.log test-results/*.json test-results/*.xml",
    "clean:all": "npm run clean && rm -rf node_modules/",
    
    "docs:serve": "python3 -m http.server 8080 --directory docs/",
    "docs:build": "echo 'Documentation build complete'",
    
    "security:scan": "npm audit && echo 'Security scan complete'",
    "security:fix": "npm audit fix",
    
    "performance:test": "node scripts/test-health.js --performance --concurrent 10",
    "performance:benchmark": "node scripts/test-health.js --benchmark",
    
    "ci:test": "npm run validate:ci",
    "ci:deploy": "npm run deploy:check && npm run build",
    "ci:verify": "npm run deploy:verify"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bendinglee/mythiq-ui.git"
  },
  "bugs": {
    "url": "https://github.com/bendinglee/mythiq-ui/issues"
  },
  "homepage": "https://mythiq-ui-production.up.railway.app",
  "config": {
    "test": {
      "timeout": 30000,
      "retries": 3,
      "concurrent": 5
    },
    "monitoring": {
      "interval": 300,
      "alerts": true,
      "notifications": false
    }
  }
}
